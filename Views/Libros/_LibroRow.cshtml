@model Biblioteca.Web.Models.Libro

<tr>
    <td>@Model.LibroId</td>
    <td>@Model.Titulo</td>
    <td>@Model.ISBN</td>
    <td>@Model.AutorNombre</td>
    <td class="text-center">@Model.Ejemplares</td>
    <td class="text-center">
        <a asp-action="Details" asp-route-id="@Model.LibroId"
           class="btn btn-sm btn-info">Detalles</a>
        <a asp-action="Edit" asp-route-id="@Model.LibroId"
           class="btn btn-sm btn-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.LibroId"
           class="btn btn-sm btn-danger">Eliminar</a>
    </td>
</tr>