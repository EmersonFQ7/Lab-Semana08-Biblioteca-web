@model Biblioteca.Web.Models.Libro

<h1>@ViewData["Title"]</h1>

<div class="alert alert-warning">
    <strong>¿Estas seguro de eliminar este libro?</strong><br />
    Esta accion marcara el libro como inactivo (eliminacion logica).
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Titulo)</dt>
            <dd class="col-sm-9">@Model.Titulo</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ISBN)</dt>
            <dd class="col-sm-9">@Model.ISBN</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.AutorNombre)</dt>
            <dd class="col-sm-9">@Model.AutorNombre</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Ejemplares)</dt>
            <dd class="col-sm-9">@Model.Ejemplares</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LibroId" />
    <button type="submit" class="btn btn-danger">Si, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>