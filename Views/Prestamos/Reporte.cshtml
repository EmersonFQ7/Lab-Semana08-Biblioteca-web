@model IEnumerable<Biblioteca.Web.Models.PrestamoReporte>

@{
    var desde = ViewData["Desde"] as string;
    var hasta = ViewData["Hasta"] as string;
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Reporte" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label for="desde" class="form-label">Desde</label>
        <input type="date" id="desde" name="desde" value="@desde" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="hasta" class="form-label">Hasta</label>
        <input type="date" id="hasta" name="hasta" value="@hasta" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Generar reporte</button>
    </div>
</form>

<p class="text-muted">
    Rango consultado: <strong>@desde</strong> a <strong>@hasta</strong>
    &mdash; Total de registros: <strong>@Model.Count()</strong>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Socio</th>
            <th>DNI</th>
            <th>Libro</th>
            <th class="text-center">Fecha prestamo</th>
            <th class="text-center">Fecha limite</th>
            <th class="text-center">Fecha devolucion</th>
            <th class="text-center">Estado</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    No se encontraron prestamos en el rango seleccionado.
                </td>
            </tr>
        }
        else
        {
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.SocioNombre</td>
                    <td>@p.SocioDNI</td>
                    <td>@p.LibroTitulo</td>
                    <td class="text-center">@p.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">@p.FechaLimite.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        @(p.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "-")
                    </td>
                    <td class="text-center">
                        @if (p.FechaDevolucion != null)
                        {
                            <span class="badge bg-success">Devuelto</span>
                        }
                        else if (p.FechaLimite < DateTime.Today)
                        {
                            <span class="badge bg-danger">Vencido</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>